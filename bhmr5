local BindButton = CreateButton("Menu Bind: " .. CurrentKeybind.Name, SettingsColumn, function() end)
BindButton.MouseButton1Click:Connect(function()
    IsChangingKeybind = true
    BindButton.Text = "Press any key..."
    local connection
    connection = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            CurrentKeybind = input.KeyCode
            BindButton.Text = "Menu Bind: " .. CurrentKeybind.Name
            IsChangingKeybind = false
            connection:Disconnect()
        end
    end)
end)

