    TextBox.PlaceholderText = placeholder
    TextBox.Text = ""
    TextBox.TextColor3 = Theme.TextMain
    TextBox.TextSize = 13
    TextBox.Font = Enum.Font.Arcade
    TextBox.TextWrapped = true
    TextBox.ClearTextOnFocus = false
    TextBox.Parent = Frame
    
    local function updateValue(val, skipCallback)
        TextBox.Text = val
        if not skipCallback then
            Config[placeholder] = val
            callback(val)
        end
    end
    
    TextBoxes[placeholder] = updateValue
    Config[placeholder] = ""
    
    TextBox.FocusLost:Connect(function()
        updateValue(TextBox.Text)
    end)
    
    return TextBox
end

