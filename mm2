local function SaveConfig()
    if isfolder and makefolder and writefile and game:GetService("HttpService") then
        if not isfolder(ConfigFolderName) then
            makefolder(ConfigFolderName)
        end
        local json = game:GetService("HttpService"):JSONEncode(Config)
        writefile(ConfigFolderName .. "/" .. ConfigFileName .. ".json", json)
        Notify("Config", "Saved successfully as " .. ConfigFileName .. "!")
        if RefreshConfigList then RefreshConfigList() end
    else
        Notify("Config", "Executor doesn't support file saving!")
    end
end

local function LoadConfig()
    if isfolder and isfile and readfile and game:GetService("HttpService") then
        local path = ConfigFolderName .. "/" .. ConfigFileName .. ".json"
        if isfile(path) then
            local success, json = pcall(function() return readfile(path) end)
            if success and json then
                local successDec, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(json) end)
                if successDec and decoded then
                    for key, value in pairs(decoded) do
                        Config[key] = value
                        if Toggles[key] then Toggles[key](value, true) end
                        if Sliders[key] then Sliders[key](value) end
                        if TextBoxes[key] then TextBoxes[key](value, true) end
                    end
                    Notify("Config", "Loaded " .. ConfigFileName .. " successfully!")
                else
                    Notify("Config", "Config file corrupted!")
                end
            end
        else
            Notify("Config", "Config file '" .. ConfigFileName .. "' not found!")
        end
    else
        Notify("Config", "Executor doesn't support file reading!")
    end
end

local function DeleteConfig()
    if isfolder and isfile and delfile then
        local path = ConfigFolderName .. "/" .. ConfigFileName .. ".json"
        if isfile(path) then
            delfile(path)
            Notify("Config", "Deleted " .. ConfigFileName .. " successfully!")
            if RefreshConfigList then RefreshConfigList() end
        else
            Notify("Config", "Config file '" .. ConfigFileName .. "' not found!")
        end
    else
        Notify("Config", "Executor doesn't support file deleting!")
    end
end

