local function CreatePage(name, icon)
    local Page = Instance.new("Frame")
    Page.Size = UDim2.new(1, 0, 0, 0)
    Page.AutomaticSize = Enum.AutomaticSize.Y
    Page.BackgroundTransparency = 1
    Page.Visible = false
    Page.Parent = PagesContainer
    
    local PageLayout = Instance.new("UIListLayout")
    PageLayout.FillDirection = Enum.FillDirection.Vertical
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 15)
    PageLayout.Parent = Page
    
    Pages[name] = Page
    
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(1, 0, 0, 38)
    TabButton.BackgroundTransparency = 1
    TabButton.Text = icon ~= "" and (icon .. "  " .. name) or name
    TabButton.TextColor3 = Theme.TextDark
    TabButton.TextSize = 13
    TabButton.Font = Enum.Font.Arcade
    TabButton.TextXAlignment = Enum.TextXAlignment.Left
    TabButton.Parent = Sidebar
    
    local TabPadding = Instance.new("UIPadding")
    TabPadding.PaddingLeft = UDim.new(0, 18)
    TabPadding.Parent = TabButton
    
    TabButton.MouseButton1Click:Connect(function()
        for pName, p in pairs(Pages) do 
            if pName ~= name then p.Visible = false end
        end
        for _, t in pairs(Tabs) do 
            TweenService:Create(t, TweenInfo.new(0.2), {TextColor3 = Theme.TextDark, BackgroundTransparency = 1}):Play()
        end
        
        Page.Visible = true
        Page.Position = UDim2.new(0, 10, 0, 0)
        Page.Size = UDim2.new(1, -10, 1, 0)
        
        TweenService:Create(Page, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 1, 0)}):Play()
        TweenService:Create(TabButton, TweenInfo.new(0.2), {TextColor3 = Theme.Accent, BackgroundColor3 = Color3.fromRGB(25, 22, 35), BackgroundTransparency = 0.7}):Play()
    end)
    
    Tabs[name] = TabButton
    return Page, TabButton
end

