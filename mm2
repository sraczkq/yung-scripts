local function UpdateVisualSphere(radius)
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = player.Character.HumanoidRootPart
    
    if not VisualSphere or VisualSphere.Parent == nil then
        VisualSphere = Instance.new("Part")
        VisualSphere.Anchored = false
        VisualSphere.CanCollide = false
        VisualSphere.CanTouch = false
        VisualSphere.CanQuery = false
        VisualSphere.Color = Color3.fromRGB(0, 255, 100)
        VisualSphere.Material = Enum.Material.SmoothPlastic
        VisualSphere.Transparency = 0
        
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.Sphere
        mesh.Parent = VisualSphere
        
        local box = Instance.new("SelectionBox")
        box.Color3 = Color3.fromRGB(0, 255, 100)
        box.LineThickness = 0.15
        box.Transparency = 0
        box.Adornee = VisualSphere
        box.Parent = VisualSphere

        local weld = Instance.new("Weld")
        weld.Part0 = hrp
        weld.Part1 = VisualSphere
        weld.C0 = CFrame.new()
        weld.C1 = CFrame.new()
        weld.Parent = VisualSphere
        
        VisualSphere.Parent = player.Character
    end
    
    local diameter = radius * 2
    VisualSphere.Size = Vector3.new(diameter, diameter, diameter)
    
    local mesh = VisualSphere:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        mesh.Scale = Vector3.new(-1, 1, 1) 
    end
    
    LastSphereUpdate = os.clock()
    
    task.spawn(function()
        local currentCheck = LastSphereUpdate
        task.wait(1.5)
        if LastSphereUpdate == currentCheck then
            if VisualSphere then VisualSphere:Destroy() end
            VisualSphere = nil
        end
    end)
end

