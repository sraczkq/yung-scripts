function UpdateAllESP(forceReset)
    if forceReset then
        for char, hl in pairs(PlayerHighlights) do if hl then hl:Destroy() end end
        for char, gui in pairs(PlayerNames) do if gui then gui:Destroy() end end
        for coin, hl in pairs(CoinHighlights) do if hl then hl:Destroy() end end
        PlayerHighlights = {}
        PlayerNames = {}
        CoinHighlights = {}
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local head = p.Character:FindFirstChild("Head")
            
            local isMurderer = false
            local isSheriff = false
            local isHero = false
            local role = GetPlayerRole(p.Name)
            local isAlive = IsPlayerAlive(p.Name)
            
            if isAlive then
                if role == "Murderer" or p.Character:FindFirstChild("Knife") or (p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife")) then
                    isMurderer = true
                end
                if role == "Sheriff" or role == "Hero" or p.Character:FindFirstChild("Gun") or p.Character:FindFirstChild("Revolver") or (p:FindFirstChild("Backpack") and (p.Backpack:FindFirstChild("Gun") or p.Backpack:FindFirstChild("Revolver"))) then
                    isSheriff = true
                    if role == "Hero" then isHero = true end
                end
            end

            local espColor = Color3.fromRGB(50, 255, 50)
            if isMurderer then
                espColor = Color3.fromRGB(255, 50, 50)
            elseif isSheriff then
                if isHero then
                    espColor = Color3.fromRGB(255, 250, 0)
                else
                    espColor = Color3.fromRGB(50, 50, 255)
                end
            end

            local shouldShowESP = false
            if isAlive then
                if isMurderer and MurdererESPEnabled then
                    shouldShowESP = true
                elseif isSheriff and SheriffESPEnabled then
                    shouldShowESP = true
                elseif not isMurderer and not isSheriff and InnocentESPEnabled then
                    shouldShowESP = true
                end
            end

            if shouldShowESP then
                if forceReset or not PlayerHighlights[p.Character] or not p.Character:FindFirstChildOfClass("Highlight") then
                    if PlayerHighlights[p.Character] then PlayerHighlights[p.Character]:Destroy() end
                    local hl = Instance.new("Highlight")
                    hl.Adornee = p.Character
                    hl.FillColor = espColor
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Parent = p.Character
                    PlayerHighlights[p.Character] = hl
                else
                    PlayerHighlights[p.Character].FillColor = espColor
                end
            else
                if PlayerHighlights[p.Character] then PlayerHighlights[p.Character]:Destroy() PlayerHighlights[p.Character] = nil end
            end
            
            local shouldShowName = (NamesESPEnabled and isAlive) or shouldShowESP
            if shouldShowName and head then
                if forceReset or not PlayerNames[p.Character] or not head:FindFirstChild("YungNameESP") then
                    if PlayerNames[p.Character] then PlayerNames[p.Character]:Destroy() end
                    local bb = Instance.new("BillboardGui")
