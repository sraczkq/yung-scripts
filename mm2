local function GetPlayerRole(playerName)
    if CachedRoles and CachedRoles[playerName] then
        return CachedRoles[playerName].Role
    end
    return nil
end

IsPlayerAlive = function(playerName)
    if CachedRoles and CachedRoles[playerName] then
        local data = CachedRoles[playerName]
        if not data.Killed and not data.Dead then
            return true
        end
    end
    return false
end

local function GetMurderer()
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if GetPlayerRole(p.Name) == "Murderer" then
            return p
        end
        if p.Character then
            if p.Character:FindFirstChild("Knife") then return p end
            if p:FindFirstChild("Backpack") and p.Backpack:FindFirstChild("Knife") then return p end
        end
    end
    return nil
end

