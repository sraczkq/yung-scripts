local function ExecuteKillAll()
    if KillAllRunning then return end
    KillAllRunning = true
    task.spawn(function()
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then KillAllRunning = false return end
        
        local hasKnife = false
        if char:FindFirstChild("Knife") then hasKnife = true end
        for _, v in pairs(player.Backpack:GetChildren()) do
            if v.Name == "Knife" then hasKnife = true end
        end
        if not hasKnife then
            Notify("Combat", "You don't have the knife!")
            KillAllRunning = false
            return
        end
        
        local knife = player.Backpack:FindFirstChild("Knife")
        if knife then
            char.Humanoid:EquipTool(knife)
            task.wait(0.2)
        end
        
        local hrp = char.HumanoidRootPart
        local oldPos = hrp.CFrame
        
        local bv = Instance.new("BodyVelocity")
        bv.Name = "KillAllBV"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
        
        local VirtualUser = game:GetService("VirtualUser")
        VirtualUser:CaptureController()
        
        if typeof(firetouchinterest) == "function" then
            for attempt = 1, 3 do
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 and IsPlayerAlive(p.Name) then
                        local targetHrp = p.Character.HumanoidRootPart
                        hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3)
                        local currentKnife = char:FindFirstChild("Knife")
                        if currentKnife and currentKnife:FindFirstChild("Handle") then
                            currentKnife:Activate()
                            VirtualUser:ClickButton1(Vector2.new())
                            firetouchinterest(currentKnife.Handle, targetHrp, 0)
                            firetouchinterest(currentKnife.Handle, targetHrp, 1)
                        end
                        task.wait()
                    end
                end
                task.wait(0.05)
            end
        else
            for attempt = 1, 15 do
                if not KillAllRunning then break end
                local anyoneAlive = false
                for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 and IsPlayerAlive(p.Name) then
                        anyoneAlive = true
                        local targetHrp = p.Character.HumanoidRootPart
                        hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3)
                        local currentKnife = char:FindFirstChild("Knife")
                        if currentKnife then currentKnife:Activate() end
                        VirtualUser:ClickButton1(Vector2.new())
                        task.wait()
                    end
                end
                if not anyoneAlive then break end
            end
        end
        
        if bv then bv:Destroy() end
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        hrp.CFrame = oldPos
        KillAllRunning = false
        Notify("Combat", "Kill All Finished!")
    end)
end

local function ExecuteKillMurderer()
    local char = player.Character
    if not char then return end
    
    local hasGun = false
    local gunItem = nil
    for _, v in pairs(char:GetChildren()) do
