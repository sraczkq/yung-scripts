local function CreateToggle(text, parent, callback)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Size = UDim2.new(1, 0, 0, 24)
    ToggleFrame.BackgroundTransparency = 1
    ToggleFrame.Parent = parent
    
    local Checkbox = Instance.new("TextButton")
    Checkbox.Size = UDim2.new(0, 16, 0, 16)
    Checkbox.Position = UDim2.new(0, 0, 0.5, -8)
    Checkbox.BackgroundColor3 = Theme.DarkElement
    Checkbox.BorderColor3 = Theme.Border
    Checkbox.Text = ""
    Checkbox.Font = Enum.Font.Arcade
    Checkbox.Parent = ToggleFrame
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -26, 1, 1)
    Label.Position = UDim2.new(0, 26, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Theme.TextMain
    Label.TextSize = 14
    Label.Font = Enum.Font.Arcade
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ToggleFrame
    
    local enabled = false
    
    local function updateState(newState, skipCallback)
        enabled = newState
        local targetColor = enabled and Theme.Accent or Theme.DarkElement
        TweenService:Create(Checkbox, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
        Checkbox.Text = enabled and "✓" or ""
        Checkbox.TextColor3 = Theme.TextMain
        if not skipCallback then
            Config[text] = enabled
            callback(enabled)
        end
    end
    
    Toggles[text] = updateState
    Config[text] = false
    
    Checkbox.MouseButton1Click:Connect(function()
        updateState(not enabled)
    end)
    
    return updateState
end

local function CreateSlider(text, parent, min, max, default, callback)
    local SliderFrame = Instance.new("Frame")
    SliderFrame.Size = UDim2.new(1, 0, 0, 40)
    SliderFrame.BackgroundTransparency = 1
    SliderFrame.Parent = parent

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 16)
    Label.BackgroundTransparency = 1
    Label.Text = text .. ": " .. tostring(default)
    Label.TextColor3 = Theme.TextMain
    Label.TextSize = 13
    Label.Font = Enum.Font.Arcade
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = SliderFrame

    local SliderBack = Instance.new("Frame")
    SliderBack.Size = UDim2.new(1, 0, 0, 6)
    SliderBack.Position = UDim2.new(0, 0, 0, 24)
    SliderBack.BackgroundColor3 = Theme.DarkElement
    SliderBack.BorderColor3 = Theme.Border
    SliderBack.Parent = SliderFrame

    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    SliderFill.BackgroundColor3 = Theme.Accent
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderBack

    local MouseDown = false

    local function UpdateValue(input, forceValue)
        local value
        if forceValue ~= nil then
            value = forceValue
        else
            local pos = math.clamp((input.Position.X - SliderBack.AbsolutePosition.X) / SliderBack.AbsoluteSize.X, 0, 1)
            value = math.floor(min + (max - min) * pos)
        end
        local pos = math.clamp((value - min) / (max - min), 0, 1)
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        Label.Text = text .. ": " .. tostring(value)
        Config[text] = value
        callback(value)
    end
    
    Sliders[text] = function(val) UpdateValue(nil, val) end
    Config[text] = default

    SliderBack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if MainFrame then MainFrame.Draggable = false end
            MouseDown = true
            UpdateValue(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            MouseDown = false
            if MainFrame then MainFrame.Draggable = true end
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if MouseDown and input.UserInputType == Enum.UserInputType.MouseMovement then
            UpdateValue(input)
        end
    end)
end

