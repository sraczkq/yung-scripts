local function FlingTarget(targetPlayer)
    local char = player.Character
    local targetChar = targetPlayer.Character
    if not char or not targetChar then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetHrp then return end
    
    local oldPos = hrp.CFrame
    local oldCollide = {}
    
    for _, v in next, char:GetDescendants() do
        if v:IsA("BasePart") then
            oldCollide[v] = v.CanCollide
            v.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
            v.Massless = true
            v.CanCollide = false
        end
    end
    
    local isDone = false
    local function cleanup()
        if isDone then return end
        isDone = true
        if char and char:FindFirstChild("HumanoidRootPart") then
            local currentHrp = char.HumanoidRootPart
            for _, v in next, char:GetDescendants() do
                if v:IsA("BasePart") then
                    v.CustomPhysicalProperties = nil
                    v.Massless = false
                    if oldCollide[v] ~= nil then
                        v.CanCollide = oldCollide[v]
                    end
                end
            end
            currentHrp.Velocity = Vector3.zero
            currentHrp.RotVelocity = Vector3.zero
            currentHrp.CFrame = oldPos + Vector3.new(0, 3, 0)
            task.wait(0.1)
            currentHrp.CFrame = oldPos + Vector3.new(0, 3, 0)
        end
    end
    
    task.delay(3, cleanup)
    
    task.spawn(function()
        while not isDone do
            if not (char and char.Parent and hrp and hrp.Parent and targetChar and targetChar.Parent and targetHrp and targetHrp.Parent and targetChar:FindFirstChild("Head")) then
                cleanup()
                break
            end
            
            hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 0)
            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.RotVelocity = Vector3.new(0, 50000, 0)
            
            game:GetService("RunService").Heartbeat:Wait()
        end
    end)
end

